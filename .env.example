# ── Copy to .env.local for development. Production uses Secret Manager +
# ── infra/env.prod.yaml (see docs/DEPLOY.md).

# Database (npm run db:up starts this locally)
DATABASE_URL=postgres://goods:goods@localhost:5432/goods
# Optional: direct (non-pooled) URL for migrations; defaults to DATABASE_URL
DATABASE_URL_DIRECT=
DATABASE_POOL_MAX=5

# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me
# ".goods.et" in production so the login works on shop subdomains
COOKIE_DOMAIN=

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shops live at <handle>.<ROOT_DOMAIN> when SHOP_SUBDOMAINS=true (needs a
# wildcard domain); otherwise at <app>/s/<handle>
ROOT_DOMAIN=localhost:3000
SHOP_SUBDOMAINS=false

# Telegram (@BotFather). Use a separate dev bot + a tunnel (cloudflared/ngrok)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# A-Z a-z 0-9 _ - only: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Mini App short name from BotFather /newapp (t.me/<bot>/<short_name>)
TELEGRAM_MINI_APP_SHORT_NAME=
# Your Telegram user id: receives ops alerts (AI budget breaker, webhook health)
OPS_TELEGRAM_CHAT_ID=

# AI listing extraction (optional locally: falls back to the rule-based parser)
# Dev: Gemini API key. Prod: leave empty and set GOOGLE_CLOUD_PROJECT (Vertex AI).
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
LLM_MODEL=gemini-2.5-flash
# Hard daily platform-wide spend cap (USD) and per-shop call quotas
AI_DAILY_BUDGET_USD=3
AI_SHOP_DAILY_QUOTA=100
AI_NEW_SHOP_DAILY_QUOTA=20
AI_PRICE_INPUT_PER_M=0.3
AI_PRICE_OUTPUT_PER_M=2.5

# Background jobs: "inline" (local only), "db" (Vercel: Postgres queue),
# "cloud" (Cloud Run: Cloud Tasks). On Vercel, "inline" is treated as "db"
# because serverless freezes kill in-memory timers.
TASKS_MODE=inline
# Vercel/GitHub cron calls /internal/cron/* with this as a Bearer token: openssl rand -hex 32
CRON_SECRET=
TASKS_PROJECT=
TASKS_LOCATION=europe-west1
TASKS_TARGET_URL=
TASKS_SERVICE_ACCOUNT=
TASKS_AUDIENCE=
# Dev only: lets you curl /internal/* with header x-internal-secret
INTERNAL_DEV_SECRET=

# Media: Cloudflare R2. Empty = local files under .data/uploads (dev only)
S3_ENDPOINT=
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
# Legacy alias accepted if MEDIA_PUBLIC_URL is empty
# S3_PUBLIC_URL=
# Optional Worker fallback when S3 access keys are not set (older Postify deploys)
# MEDIA_UPLOAD_URL=
# MEDIA_UPLOAD_SECRET=

# Optional: purge Cloudflare cache when a shop changes
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
